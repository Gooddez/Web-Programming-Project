<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menus</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header>
        <div class="header-banner">
            <div class="basket-container"><button class="basket-button"></button></div>
        </div>
        <div class="navigation-bar">
            <a href="/menu/1" class="nav-item"></a>
            <a href="/menu/2" class="nav-item"></a>
            <a href="/menu/3" class="nav-item"></a>
            <a href="/menu/4" class="nav-item"></a>
        </div>
    </header>
    <div class="header-gap"></div>
    <section class="content">
        <% menuData.forEach(menu => { %>
            <a href="/detail?id=<%= menu.menu_id %>">
                <div class="menu-container">
                    <div class="status">In Stock</div>
                    <img src="/image/<%= menu.menu_image.slice(0,-4) %>.png" alt="<%= menu.menu_image.slice(0,-4) %>.png">
                    <div class="text-container">
                        <span><%= menu.menu_name %></span>
                        <span><%= menu.menu_price %></span>
                    </div>
                </div>
            </a>
        <% }) %>
    </section>
</body>
</html>