<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menus</title>
    <link rel="stylesheet" href="/css/menus.css">
    <script src="/js/menus.js"></script>
</head>

<body>
    <header>
        <div class="header-banner">
            <div><a href="/menu/1" class="nav-item"></a></div>
            <div><a href="/menu/2" class="nav-item"></a></div>
            <div><a href="/menu/3" class="nav-item"></a></div>
            <div><a href="/menu/4" class="nav-item"></a></div>
            <div id="cart" class="cart-button" onclick="showCart()">ตะกร้า</div>
        </div>

        <div id="cartContainer" class="cart-container"></div>

        <div class="navigation-bar">
            
        </div>
    </header>

    <div class="header-gap"></div>
    <section class="content">
        <% menuData.forEach(menu=> { %>
            <div class="menu-container" id="menu-container-<%= menu.menu_id %>"
                onclick="showDetail('<%= menu.menu_id %>')">
                <div class="status">In Stock</div>
                <img src="/image/<%= menu.menu_image %>" alt="<%= menu.menu_image %>">
                <div class="text-container">
                    <span><%= menu.menu_name %></span>
                    <span><%= menu.menu_price %></span>
                </div>
            </div>
        <% }) %>
    </section>

    <% menuData.forEach(menu=> { %>
        <div class="detail-container" id="detail-container-<%= menu.menu_id %>">
            <button onclick="closeDetail('<%= menu.menu_id %>')" class="close-detail-button">X</button>
            <img src="/image/<%= menu.menu_image %>" alt="<%= menu.menu_image %>">
            <div class="right-detail-container">
                <div class="detail-name-container">
                    <h2><%= menu.menu_name %></h2>
                    <p><%= menu.menu_description %></p>
                </div>

                <div id="form-container-<%= menu.menu_id %>" class="form-container">
                    <form action="/add-to-cart" method="get" id="customize-form-<%= menu.menu_id %>" class="customize-detail"></form>
                    
                    <div class="price" id="price-<%= menu.menu_id %>" data-normalprice="<%= menu.menu_price %>">
                        Price: <%= menu.menu_price %> THB
                    </div>
                        </div>
            </div>
        </div>
    <% }) %>
</body>
</html>