<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Orders</title>
    <link rel="stylesheet" href="/css/orders.css">
</head>
<body>
    <div class="container-order">
        <% if (data.length === 0) { %>
            <h1 class="txt">ยังไม่มีรายการสินค้า หรือยังไม่ได้ชำระเงินรายการสินค้า</h1>
        <% } %>
        <% data.forEach(item => { %>
            <div class="order">
                <h2>หมายเลขออเดอร์ <%= item.orderid %> โต๊ะ : <%= item.table_id %></h2>
                <p class="type">ประเภท : <span>ทานที่ร้าน</span> | <%= new Date(item.created_at.replace(' ', 'T')).toLocaleTimeString('en-US') %> </p>
                <div class="detail">
                    <% const menuContent = JSON.parse(item.menu); %>
                    <% menuContent.forEach(product => { %>
                        <div class="item-detail">
                            <p class="menu-name"><%= product.menu_name %></p>
                            <% if (product.options.length === 0) { %>
                                <p>รายละเอียด : ไม่มีรายการปรับแต่ง</p>
                                <p>จำนวน : <%= product.quantity %></p>
                            <% } else { %>
                                <p>รายละเอียด : <%= product.options.map(opt => opt.name).join(', ') %></p>
                                <p>จำนวน : <%= product.quantity %></p>
                            <% } %>
                        </div>
                    <% }); %>
                </div>
            </div>
        <% }); %>
        <a href="/menus"><div class="back-to-home-button">กลับหน้าเมนู</div></a>
    </div>
</body>
</html>