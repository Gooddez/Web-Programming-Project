<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail</title>
</head>
<body>
    <h2>THIS IS DETAIL</h2>
    <% let exist = [] %>
    <% detailData.forEach(item => { %>
        <div class="detail-container">
            <% if (exist.length === 0) {%>
                <img src="/image/<%= item.menu_image.slice(0,-4) %>.png" alt="<%= item.menu_image.slice(0,-4) %>.png">
                <div class="detail-desc"><h2><%= item.menu_name %></h2>
            <% } %>

            <% if (!(item.option_id in exist))  {%>
                <p>Option: <%= item.option_name %></p>
                <p>Value: <%= item.value_name %></p>
                <p>Extra Price: <%= item.extra_price %></p>
            <% } else { %>
                <p>Value: <%= item.value_name %></p>
                <p>Extra Price: <%= item.extra_price %></p>
            <% } %>
            </div>
            <% exist.push(item.option_id) %>
            <% console.log(exist) %>
        </div>
    <% }) %>
</body>
</html>