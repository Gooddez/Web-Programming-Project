<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Detail</title>
    <link rel="stylesheet" href="/css/details.css">
</head>
<body>
    <% let optionMap = {}; %> <% detailData.forEach(item => { %>
    <% if (!optionMap[item.option_id]) { %> <% optionMap[item.option_id] = {
        option_name: item.option_name, values: [] }; %>
    <% } %> 
    <% optionMap[item.option_id].values.push({ value_name: item.value_name,
        extra_price: item.extra_price }); %>
    <% }) %>

    <div class="detail-container">
        <div class="detail-img">
            <% if (detailData && detailData[0]) { %>
                <img src="/image/<%= detailData[0].menu_image.slice(0,-4) %>.png" alt="<%= detailData[0].menu_image.slice(0,-4) %>.png"/>
            <% } %>
        </div>
        <div class="detail-info">
            <% if (detailData && detailData[0]) { %>
                <div class="detail-text">
                    <h2><%= detailData[0].menu_name %></h2>
                    <p><%= detailData[0].menu_description %></p>
                </div>
            <% } %>
                
            <div class="detail-options">
                <% Object.keys(optionMap).forEach(function(optId) { %>
                <div class="detail-option-contain">
                    <p class="option-name"><%= optionMap[optId].option_name %></p>
                    <div class="in-option">
                        <% optionMap[optId].values.forEach(function(v) { %>
                            <div class="extra">
                                <p><%= v.value_name %></p>
                                <p>+<%= v.extra_price %> ฿</p>
                            </div>
                        <% }) %>
                    </div>
                </div>
            <% }) %>
            </div>
        </div>
    </div>
</body>
</html>
